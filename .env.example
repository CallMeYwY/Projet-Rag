# Depuis l'API du Compose, qdrant désigne le service sur le réseau Docker.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION=documents_v2
QDRANT_PORT=6333
API_PORT=8000

# Les embeddings restent locaux, même si la génération passe par OpenRouter.
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BATCH_SIZE=32
TIMEOUT=120

# Le suffixe /v1 correspond à l'API Chat Completions d'Ollama.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=
LLM_TIMEOUT=180

# Les tailles de découpage et de contexte sont en caractères.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNKS=2048
MAX_TOP_K=30
# Vide : aucun seuil imposé. Une requête peut fournir son propre seuil cosinus.
SCORE_THRESHOLD=
MAX_CONTEXT_CHARS=6000

# Limites par fichier. OCR_TIMEOUT est exprimé en secondes.
MAX_FILE_BYTES=10485760
MAX_EXTRACTED_CHARS=250000
MAX_PAGES=100
MAX_IMAGE_PIXELS=20000000
OCR_LANGUAGES=fra+eng
OCR_TIMEOUT=30
